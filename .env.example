# Proveedor de música: simulated | youtube
MUSIC_PROVIDER=simulated
YOUTUBE_API_KEY=
YOUTUBE_MAX_RESULTS=20
YOUTUBE_MUSIC_CATEGORY_ID=10
# YOUTUBE_REGION_CODE=CO

# Caché de búsquedas del catálogo (RNF-024)
CATALOG_CACHE_TTL_S=300
CATALOG_CACHE_MAX_ENTRIES=256

# Base de datos (el compose define su propio DATABASE_URL para el contenedor)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=openmusic
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/openmusic

# Catálogo: importa las playlists simuladas al arrancar el contenedor.
# Úsalo solo con MUSIC_PROVIDER=simulated.
SEED_CATALOG=false

# Seguridad: genera un valor propio, por ejemplo con `openssl rand -hex 32`.
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:8956,http://127.0.0.1:8956
LOGIN_ATTEMPTS_PER_MINUTE=5
PASSWORD_MIN_LENGTH=8

# Reglas del SRS
PREVIOUS_TRACK_THRESHOLD_S=5
SKIPPED_THRESHOLD_S=30
MAX_PLAYLISTS_PER_USER=50
MAX_TRACKS_PER_PLAYLIST=500
PLAYLIST_NAME_MAX_LENGTH=80
SEARCH_MIN_CHARS=2
ONBOARDING_MIN_GENRES=3
ONBOARDING_MAX_GENRES=5
GENRE_INITIAL_WEIGHT_MIN=10
ARTIST_INITIAL_WEIGHT_MIN=5
PREFERENCE_HALVING_MINUTES=120
RECENCY_HALF_LIFE_DAYS=14
RECOMMENDATIONS_LIST_SIZE=20
EXPLORATION_SHARE=0.30

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Variables opcionales de herramientas
# -----------------------------------------------------------------------------
# Etiqueta de la imagen de pgAdmin usada por docker-compose.yml.
PGADMIN_TAG=latest

# Base de datos aislada para pytest. No uses la base de desarrollo.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/openmusic_test

# URL base de la API para el frontend cuando se ejecuta fuera de Docker.
# En Docker NO se necesita: nginx ya reenvía /api al backend.
# Para Vite local, defínela en frontend/.env.local o en la terminal.
# VITE_API_BASE_URL=http://127.0.0.1:7845

# Aclaración: la YouTube IFrame Player API se ejecuta en el navegador y no usa
# clave. La única clave de YouTube que se configura aquí es YOUTUBE_API_KEY
# (YouTube Data API v3, usada por el backend).
