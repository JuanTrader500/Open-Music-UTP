# Proveedor de música: simulated | youtube
MUSIC_PROVIDER=simulated
YOUTUBE_API_KEY=
YOUTUBE_MAX_RESULTS=20
YOUTUBE_MUSIC_CATEGORY_ID=10
# YOUTUBE_REGION_CODE=CO

# Base de datos (el compose define su propio DATABASE_URL para el contenedor)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=openmusic
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/openmusic

# Seguridad
JWT_SECRET=cambia-esto-por-una-cadena-aleatoria-de-32-caracteres-o-mas
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:8080
LOGIN_ATTEMPTS_PER_MINUTE=5
PASSWORD_MIN_LENGTH=8

# Reglas del SRS
PREVIOUS_TRACK_THRESHOLD_S=5
SKIPPED_THRESHOLD_S=30
MAX_PLAYLISTS_PER_USER=50
MAX_TRACKS_PER_PLAYLIST=500
PLAYLIST_NAME_MAX_LENGTH=80
SEARCH_MIN_CHARS=2
ONBOARDING_MIN_GENRES=3
ONBOARDING_MAX_GENRES=5
GENRE_INITIAL_WEIGHT_MIN=10
ARTIST_INITIAL_WEIGHT_MIN=5
PREFERENCE_HALVING_MINUTES=120
RECENCY_HALF_LIFE_DAYS=14
RECOMMENDATIONS_LIST_SIZE=20
EXPLORATION_SHARE=0.30

# pgAdmin (solo con el perfil dev)
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
LOG_LEVEL=INFO
