
# Proveedor de música: youtube | simulated
MUSIC_PROVIDER=simulated

# YouTube Data API v3 (Google Cloud Console -> Credenciales -> Clave de API)
YOUTUBE_API_KEY=
YOUTUBE_MAX_RESULTS=20
YOUTUBE_MUSIC_CATEGORY_ID=10
# YOUTUBE_REGION_CODE=CO


# Base de Datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=openmusic

# PgAdmin
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin

